      "seed": 904762033,
      "version": 396,
      "versionNonce": 506986801,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755928661388,
      "link": null,
      "locked": false,
      "text": "Note: All of this complexity is to ensure that the messages are not lost. The\nreason being, the pubsub redis offers has atmost one message delivery which \nmeans that the message may be lost if it is not picked up immediately. \n\nAnother workaround can be to use a different pubsub service which ensures\natleast one delivery. ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: All of this complexity is to ensure that the messages are not lost. The\nreason being, the pubsub redis offers has atmost one message delivery which \nmeans that the message may be lost if it is not picked up immediately. \n\nAnother workaround can be to use a different pubsub service which ensures\natleast one delivery. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
