    {
      "id": "Nk6P2JAIMyttL7KO9aL8r",
      "type": "text",
      "x": -3396.720781979023,
      "y": -2720.001521859574,
      "width": 506.484130859375,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f9f8fa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9PV",
      "roundness": null,
      "seed": 1644249840,
      "version": 412,
      "versionNonce": 849305782,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752737208154,
      "link": null,
      "locked": false,
      "text": "Considerations:\n1. For Now, The\nConnection to a ws will be\nstateful. That is the userid,\nsocket Pair will be stored in\nmemeory.\nFor fault tolerance it can be\nmoved to redis\n2. If a user reconnects,\nwe keep a track of last\nmessage id the user recieved\non that device and sync it",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "pyi9x3F5UBb27wsToFxKF",
      "originalText": "Considerations:\n1. For Now, The\nConnection to a ws will be stateful. That is the userid,\nsocket Pair will be stored in memeory.\nFor fault tolerance it can be moved to redis\n2. If a user reconnects,\nwe keep a track of last message id the user recieved on that device and sync it",
      "autoResize": true,
      "lineHeight": 1.25
    },
